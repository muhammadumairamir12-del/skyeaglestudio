rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();

      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.likes == 0
                    && request.resource.data.reports == 0;

      allow update: if isAdmin()
                    || (resource.data.status == 'approved'
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.review == resource.data.review
                        && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes)
                        && (request.resource.data.reports == resource.data.reports + 1 || request.resource.data.reports == resource.data.reports)
                        && (request.resource.data.flagged == resource.data.flagged || request.resource.data.flagged == true)
                        && (request.resource.data.status == 'approved' || request.resource.data.status == 'pending')
                       );

      allow delete: if isAdmin();
    }

    match /reviewReports/{reportId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /portfolioProjects/{projectId} {
      allow read: if isAdmin() || resource.data.published == true || resource.data.hidden == true;
      allow write: if isAdmin();
    }
  }
}
